# Omega Data Pipeline — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# Database (same Knock AI prod DB — world_ tables added here)
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5433/knockai

# Local data storage
OBJECT_STORAGE_PATH=/data/omega-world
RAW_DATA_PATH=./data/raw
PARQUET_PATH=./data/parquet

# API Keys
NOAA_CDO_TOKEN=YOUR_TOKEN_HERE
NASS_API_KEY=YOUR_KEY_HERE      # https://quickstats.nass.usda.gov/api/

# Target geographies (comma-separated FIPS codes)
TARGET_STATE_FIPS=26,12         # 26=Michigan, 12=Florida
